# =============================================================================
# Home Accounting — single source of configuration.
# Copy to `.env` and adjust. Ports and most settings are controlled here.
#   cp .env.example .env
# Generate a secret:  openssl rand -base64 32
# =============================================================================

# ---- Compose project (keeps this stack isolated from other containers) ----
COMPOSE_PROJECT_NAME=accounting

# ---- Timezone (used by the worker's cron schedules) ----
TZ=Asia/Taipei

# ---- Postgres ----
POSTGRES_USER=accounting
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=accounting
# Host port to expose Postgres on (container always listens on 5432 internally).
DB_PORT=5432

# Connection string used by the app.
#  - Local dev (pnpm dev, host tools):        host is localhost + DB_PORT
#  - Inside Docker (compose):                 overridden to host "db" automatically
DATABASE_URL=postgresql://accounting:change-me-postgres-password@localhost:5432/accounting

# ---- Web (Next.js: UI + tRPC + better-auth, same origin) ----
# Host port the site is reachable on. Container listens on WEB_INTERNAL_PORT.
WEB_PORT=3000
WEB_INTERNAL_PORT=3000

# ---- Auth (better-auth) ----
BETTER_AUTH_SECRET=change-me-please-generate-a-real-secret
# Public URL where the app is served (Cloudflare Tunnel hostname in prod).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated extra origins (LAN IP, Cloudflare hostname, etc.).
# TRUSTED_ORIGINS=http://10.0.0.5:3000,https://accounting.example.com
# Session: 7-day sliding window. After SESSION_UPDATE_MINUTES of activity, next request extends expiry.
SESSION_EXPIRES_DAYS=7
SESSION_UPDATE_MINUTES=15
# Default admin (db:seed-admin). Login: admin / admin — username only, no email needed.
# SECURITY: change ADMIN_PASSWORD before first run, or update it later in the app
# under 更多 ▾ → 設定 → 變更密碼.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Internal email domain (not shown to users; better-auth requires an email field).
AUTH_EMAIL_DOMAIN=users.example.com

# ---- App config ----
# Reporting base currency for net-worth aggregation. Multi-currency is fully
# supported; this is only the default currency reports convert into.
APP_BASE_CURRENCY=TWD

# ---- External sync (local stock site -> this app) ----
# Your other stock/trading site POSTs prices, holdings, FX here.
# Generate: openssl rand -base64 32
SYNC_API_KEY=
# Optional: lock sync to a specific user id. If empty, uses the first registered user.
SYNC_USER_ID=

# ---- Backups (worker -> Cloudflare R2, S3-compatible). Empty = disabled. ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
BACKUP_CRON="0 3 * * *"
