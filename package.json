{
  "name": "home-accounting",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @acc/db generate",
    "db:migrate": "pnpm --filter @acc/db migrate",
    "db:push": "pnpm --filter @acc/db push",
    "db:studio": "pnpm --filter @acc/db studio",
    "db:seed": "pnpm --filter @acc/db seed",
    "db:seed-admin": "pnpm --filter @acc/web seed-admin"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
